# Inert REVIEW TEMPLATE. Requires exact accepted installed root-control/box-control bytes.
[Unit]
Description=Zog station issuer credential root broker (no network listener)
Requires=zog-issuer-cross-host-broker.socket
After=zog-issuer-cross-host-broker.socket
ConditionPathExists=/etc/zog/issuer-credentials/cross-host-station.json

[Service]
Type=exec
User=root
Group=root
ExecStart=@EXACT_ATTESTED_PYTHON@ -I -m zog.root_control.issuer_cross_host station-broker
Restart=on-failure
RestartSec=1s
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/zog-issuer-bridge/nonces
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes

# No [Install]. The independently reviewed .socket controls activation.
